# Copie ce fichier en « .env » (même dossier) puis remplis-le.
# Le fichier .env contient des secrets : ne le partage pas et ne le mets jamais sur Git.

# --- Espace admin (http://localhost:3000/admin) ---
ADMIN_USER=maxime
ADMIN_PASSWORD=
# Chaîne aléatoire qui signe les sessions admin. Pour en générer une : openssl rand -hex 32
SESSION_SECRET=
# true = l'espace admin est invisible depuis Internet (Cloudflare Tunnel) :
# accessible seulement depuis ton réseau local ou via Tailscale. Conseillé en prod.
ADMIN_LOCAL_ONLY=false

# --- Images Top Meme ---
# Dossier de stockage (par défaut : data/memes dans le projet)
# MEMES_DIR=/chemin/vers/le/disque/memes
# MEMES_MAX_IMAGES=2000

# --- Serveur ---
# PORT=3000

# --- Docker (prod) ---
# Port du NUC sur lequel le jeu est exposé (si 3000 est déjà pris par autre chose)
# GAME_PORT=3000
